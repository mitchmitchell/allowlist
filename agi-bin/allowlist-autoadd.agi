#!/usr/bin/php -q
<?php

// FreePBX Bootstrap environment
$restrict_mods = true;
if (!@include_once(getenv('FREEPBX_CONF') ? getenv('FREEPBX_CONF') : '/etc/freepbx.conf')) {
	include_once('/etc/asterisk/freepbx.conf');
}

$FreePBX = FreePBX::Create();

// AGI Class
$agidir = FreePBX::Config()->get('ASTAGIDIR');
require_once $agidir."/phpagi.php";
require_once $agidir."/allowlist-common.php";

$AGI = new AGI();

if (!$AGI || !$FreePBX) {
	// something went wrong
	exit;
}

$AGI->verbose("script starting up");

$dnid = $AGI->request['agi_dnid'];

$res = $AGI->get_variable("DIAL_NUMBER");

if ($res['result'] == 0) {
	$dial_number = $dnid;
} else {
       $dial_number = $res['data'];
}

$AGI->verbose("initial \$dial_number = \"" . allowlistMask($dial_number) . "\"");
$digit_remcount = 0;
$digit_stocount = 99;
 
// get the number of leading digits to remove and the number of digits to store in the number automatically added to the allowlist
// these don't appear to be used
if ($argc > 2) {
	$digit_remcount = (int)trim($argv[2]);
	$digit_stocount = (int)trim($argv[3]);
}

// get the allowlist route details from ASTDB
$route_id_arr  = $AGI->get_variable("ROUTEID");
$route_id=$route_id_arr['data'];
$route_details_arr = $AGI->get_variable("DB(allowlist/autoadd/$route_id)");
$route_details=$route_details_arr['data'];
$route_details =  explode (",", $route_details_arr['data']);

$digit_remcount = (int)trim($route_details[1]);
$digit_stocount = (int)trim($route_details[2]);

$AGI->verbose("\$digit_remcount = \"$digit_remcount\"");
$AGI->verbose("\$digit_stocount = \"$digit_stocount\"");

$dial_number = substr($dial_number,$digit_remcount,$digit_stocount);

$AGI->verbose("searching for final \"" . allowlistMask($dial_number) . "\" in asterisk database");

// Only digit numbers (optional leading +) may be written to the shared allowlist family.
if (strlen($dial_number) != 0) {
	$valid_number = allowlistNormalizeNumber($dial_number);
	if ($valid_number === false) {
		$AGI->verbose("\"" . allowlistMask($dial_number) . "\" is not a valid allowlist number (digits, optional leading +), not autoadding");
		exit;
	}
	$dial_number = $valid_number;
}

if (!(searchAllowList($dial_number) || searchContactManager($dial_number) || searchAsteriskPhonebook($dial_number)) && (strlen($dial_number) != 0)) { // dialed number is not part of any of the allowed numbers so add it if it is not empty
	$AGI->verbose("adding number to allowlist");
	$done = $AGI->database_put('allowlist',$dial_number,'automatically added');
	if ($done['result'] == 0) {
		$AGI->verbose("could not add " . allowlistMask($dial_number) . " to allowlist");
	} else {
		$AGI->verbose("added " . allowlistMask($dial_number) . " to allowlist");
	}
} else {
	$AGI->verbose(allowlistMask($dial_number) . " empty or found in asterisk database, not autoadding to allowlist");
}

$AGI->verbose("scripted completed");
